[Unit]
Description=VPN Seller Telegram Bot (aiogram)
Documentation=https://github.com/mohammad1384p/vpn-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpnbot
Group=vpnbot
WorkingDirectory=/opt/vpn-bot

# ماژول bot.main از ریشه پروژه import می‌شود
Environment=PYTHONPATH=/opt/vpn-bot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# BOT_TOKEN و ADMIN_ID (و در صورت نیاز PROXY_URL) اینجا هستند
EnvironmentFile=/opt/vpn-bot/.env

ExecStart=/opt/vpn-bot/venv/bin/python -m bot.main

# ربات همیشه روشن بماند
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

# لاگ‌ها در journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn-bot

# سخت‌گیری امنیتی
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vpn-bot

[Install]
WantedBy=multi-user.target
